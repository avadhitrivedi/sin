module sine#(parameter INPUT_BITS=16,
             parameter OUTPUT_BITS=18,
             parameter LUT_DEPTH_BITS=10)(
  input clk,
  input resetn,
  input[INPUT_BITS-1:0] theta,
  input validIn,
  output[OUTPUT_BITS-1:0] sineTheta,
  output validOut);
  
  //we used preinitialised mem where we stored the sin corresponding to the MSB bits [15:6] of the theta
  reg signed[17:0] sin_lut[0:1023]; //10 bits of add means depth=1024
  reg signed[17:0] cos_lut[0:1023];
  reg [9:0]addr_s1;
  reg [5:0]frac_s1;
  reg signed[17:0] sin_base_s2;
  reg signed[17:0] cos_base_s2;
  reg [5:0]  frac_s2;
  reg signed[17:0] sin_base_s3;
  reg signed[23:0] product_s3; //it is product of 18 bit and 6 bit values
  reg signed[17:0] sin_base_s4;
  reg signed[17:0] div_s4;//output shifted by 13 position becomes a 18 bit value
  reg signed[18:0] sum_s5; //took an extra bit in register than needed to handle overflow
  reg validIn_s1,validIn_s2,validIn_s3,validIn_s4,validIn_s5;
  
  //interval one module (using pipelining)
  initial begin
  $readmemh("sin.mem", sin_lut); //loads the .mem file to the sin_lut register at the start of simualtion
  $readmemh("cos.mem", cos_lut);
  end
  
  always @(posedge clk)begin
    if(!resetn)begin
      addr_s1<=0;
      frac_s1<=0;
      cos_base_s2<=0;
      sin_base_s2<=0;
      frac_s2<=0;
      sin_base_s3<=0;
      product_s3<=0;
      sin_base_s4<=0;
      div_s4<=0;
      sum_s5<=0;
      validIn_s1<=0;
      validIn_s2<=0;
      validIn_s3<=0;
      validIn_s4<=0;
      validIn_s5<=0;
    end
    else begin
      
      addr_s1<=theta[15:6];
      frac_s1<=theta[5:0];
      validIn_s1<=validIn;
      
      sin_base_s2<=sin_lut[addr_s1];
      cos_base_s2<=cos_lut[addr_s1];
      frac_s2<=frac_s1;
      validIn_s2<=validIn_s1;
      
      sin_base_s3<=sin_base_s2;
      product_s3 <= cos_base_s2 * $signed({1'b0, frac_s2}); //If any operand is unsigned, the operation may become unsigned  
      validIn_s3<=validIn_s2;
      
      sin_base_s4<=sin_base_s3;
      div_s4<=product_s3>>>13; 
      validIn_s4<=validIn_s3;
      
      sum_s5<= sin_base_s4 + div_s4;
      validIn_s5<=validIn_s4;
    end
  end
  
  assign validOut= validIn_s5;
  assign sineTheta = sum_s5[17:0];
endmodule
